{
  "name": "monarchy-build",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:hosting": "node scripts/check-hosting.mjs"
  },
  "dependencies": {
    "geist": "1.9.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "wrangler": "4.163.0"
  },
  "engines": {
    "node": ">=22"
  }
}
